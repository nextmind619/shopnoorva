# =============================================================================
# NOORVA Store — Environment Variables
# Copy to .env.local for local development:
#   cp .env.example .env.local
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (optional locally — falls back to in-memory store) ---
DATABASE_URL=postgresql://noorva:noorva_secret@localhost:5432/noorva_ai
REDIS_URL=redis://localhost:6379

# --- Google Sheets (Orders sync) ---
# 1. Create a Google Cloud project and enable "Google Sheets API"
# 2. Create a Service Account and download the JSON key
# 3. Share your spreadsheet with the service account email (Editor access)
# 4. Set the variables below (private key must keep \n line breaks when pasted)
GOOGLE_SHEETS_ID=1zA2CxZKuLXU6AiP6JByxhGv2Mg-kXqCoKsaQN3wvp7k
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ORDER_SHEET=leads
# Optional webhook fallback (n8n / Apps Script) when service account is not set:
# GOOGLE_SHEETS_WEBHOOK=https://your-n8n-host/webhook/google-sheets-orders

# --- Codplus (direct webhook — get URL from Codplus Integrations page) ---
CODPLUS_WEBHOOK_URL=
CODPLUS_WEBHOOK_TOKEN=

# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=noorva
ADMIN_WHATSAPP=+212693428013
SUPPORT_WHATSAPP=+212693428013

# --- AI / Automation ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CRON_SECRET=change_this_secret
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# --- Email / SMS ---
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=NOORVA <orders@shopnoorva.shop>
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=NOORVA

# --- Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=noorva
MINIO_SECRET_KEY=noorva_minio_secret
MINIO_BUCKET=noorva
MINIO_USE_SSL=false

# --- Meta Pixel + Conversions API ---
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_DATASET_ID=
FACEBOOK_TEST_EVENT_CODE=

# --- TikTok Pixel + Events API ---
# Prefer TIKTOK_PIXEL_ID (runtime on EasyPanel). NEXT_PUBLIC_* works for local dev.
TIKTOK_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# --- Analytics ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# --- Fraud ---
IP_REPUTATION_URL=
IP_REPUTATION_KEY=

# --- Storefront security (anti-spy) ---
# Owner preview bypass: open /ar?nv_preview=YOUR_SECRET once to skip Access Denied while testing
SECURITY_PREVIEW_TOKEN=
SECURITY_CHALLENGE_SECRET=
